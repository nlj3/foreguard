{
  "name": "foreguard-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The commercial control plane for Foreguard: fleet view, central Cedar policy, aggregated tamper-evident audit, and spend dashboards.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply foreguard_cp --local",
    "migrate:remote": "wrangler d1 migrations apply foreguard_cp --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.0.0"
  }
}
